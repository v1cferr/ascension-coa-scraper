# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Scraper output: datasets are reproducible, assets are large binaries.
/data/**/assets/
/.cache/

# Client extraction: the JSON datasets are versioned, the binaries they name are not.
# Models, textures and sounds come out of the user's own install and are large.
/data/client/assets/

# The spellbook: 170 MB derived from the client's own tables in about twenty seconds.
/data/client/spellbook.sqlite


# OS / editor
.DS_Store
.idea/
.vscode/

# A working copy of an exported dataset, kept out of the tree so `git add -A` does not
# sweep it back in. The versioned equivalent is data/<realm>/<class>/.
/stormbringer.zip
